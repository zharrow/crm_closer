# ---------------------------------------------------------------------
# Supabase — Project Settings → API / Database
# ---------------------------------------------------------------------
# Connexion applicative : pooler en mode transaction (port 6543).
# Le `?pgbouncer=true` est requis, le code passe déjà `prepare: false`.
DATABASE_URL=postgresql://postgres.xxxx:MOTDEPASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true

# Connexion directe (port 5432), utilisée uniquement par drizzle-kit
# pour les migrations — le pooler ne sait pas exécuter du DDL.
DIRECT_URL=postgresql://postgres.xxxx:MOTDEPASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Seuls ces comptes peuvent se connecter. Séparés par des virgules.
# Sans cette liste, personne ne peut entrer — y compris toi.
ALLOWED_EMAILS=toi@exemple.fr

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
# Sans slash final. Sert aux liens de désinscription et aux rappels QStash.
NEXT_PUBLIC_APP_URL=https://ton-app.vercel.app

# openssl rand -hex 32
UNSUBSCRIBE_SECRET=

# openssl rand -hex 32 — protège /api/cron/daily.
# Sans lui le cron refuse de tourner, volontairement.
CRON_SECRET=

# ---------------------------------------------------------------------
# Anthropic — console.anthropic.com
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------
# QStash (Upstash) — console.upstash.com/qstash
# Jobs différés. Sans ces clés, les jobs s'exécutent en ligne : ça marche
# en local, mais un import de 50 leads dépassera les 60 s sur Vercel.
# ---------------------------------------------------------------------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---------------------------------------------------------------------
# Sourcing — optionnel, l'import CSV fonctionne sans
# ---------------------------------------------------------------------
# Google Cloud → API Places (New). Facturation à activer.
GOOGLE_PLACES_API_KEY=
# pappers.fr → API. Enrichissement SIREN, effectif, dirigeant.
PAPPERS_API_KEY=
